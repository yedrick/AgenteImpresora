# Binarios compilados
*.exe
*.bin

# Dependencias y artefactos de build
node_modules/
collatech-sdk/dist/
collatech-sdk/.npm-cache/
collatech-sdk/*.tgz
.gocache/

# Estado en ejecucion (no debe versionarse ni entregarse)
logs/*.jsonl
storage/jobs.json
ENTREGA_CLIENTE/logs/*.jsonl
ENTREGA_CLIENTE/storage/jobs.json

# Certificados
certs/
*.pem
*.key

# El logo por defecto va embebido en el binario; este es el que el
# cliente pone al lado del ejecutable para usar el suyo.
LOGO.png
