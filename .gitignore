# Binarios construidos. Se generan con "make build" o "make dist", y las
# versiones publicadas salen de GitHub Actions: no tienen por que estar aqui.
dist/
collatech-agent
server
CollaTechAgent.exe
INSTALADOR.exe
*.test
*.exe
