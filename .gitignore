# Pruebas locales
prueba/

# Datos que genera el agente al correr. configs/config.json SI se versiona,
# pero el agente le escribe un token al arrancar: hay una prueba en
# internal/config que falla si se cuela uno.
logs/*.jsonl
storage/jobs.json
certs/

# Node
node_modules/
collatech-sdk/*.tgz
